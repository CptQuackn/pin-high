{
  "name": "pin-high",
  "private": true,
  "type": "module",
  "description": "Pin High: a daily golf decision game. Monorepo: packages/engine (TypeScript) and legacy/ (prototype v118).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm --filter @pin-high/engine test",
    "test:physics": "pnpm --filter @pin-high/engine test:physics",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "golden:capture": "node packages/engine/scripts/capture-golden.cjs",
    "legacy:build": "pnpm --filter pin-high-legacy build",
    "legacy:test": "pnpm --filter pin-high-legacy test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
